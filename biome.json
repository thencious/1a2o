{
  "$schema": "https://biomejs.dev/schemas/2.5.1/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off",
        "noUselessElse": "off",
        "noProcessEnv": "off",
        "useBlockStatements": "off",
        "useFilenamingConvention": "off",
        "noNestedTernary": "off",
        "noNegationElse": "off",
        "noEnum": "off",
        "noExportedImports": "off",
        "useAtIndex": "off",
        "useCollapsedIf": "off",
        "useConsistentArrayType": "off",
        "useDefaultSwitchClause": "off",
        "useCollapsedElseIf": "off",
        "useConsistentObjectDefinitions": "off",
        "noMagicNumbers": "off",
        "useConsistentTypeDefinitions": "off"
      },
      "suspicious": {
        "noConsole": "warn",
        "noExplicitAny": "warn",
        "noArrayIndexKey": "off",
        "noEmptyBlockStatements": "off",
        "useAwait": "off",
        "noEvolvingTypes": "off",
        "noDocumentCookie": "off",
        "noConstantBinaryExpressions": "off",
        "noBitwiseOperators": "off",
        "noTsIgnore": "off",
        "useIterableCallbackReturn": "off",
        "noUnknownAtRules": "off",
        "noAlert": "off",
        "noShadow": "off",
        "noUnnecessaryConditions": "off"
      },
      "complexity": {
        "noForEach": "off",
        "useSimplifiedLogicExpression": "off",
        "noExcessiveCognitiveComplexity": "off",
        "useArrowFunction": "off"
      },
      "nursery": {
        "useSortedClasses": "off"
      },
      "performance": {
        "useTopLevelRegex": "off",
        "noNamespaceImport": "off",
        "noAwaitInLoops": "off"
      },
      "correctness": {
        "noUnusedImports": "warn",
        "noUnusedVariables": "warn",
        "noUnusedFunctionParameters": "warn",
        "useExhaustiveDependencies": "warn",
        "useParseIntRadix": "off",
        "noNestedComponentDefinitions": "off"
      },
      "a11y": {
        "useSemanticElements": "off",
        "noStaticElementInteractions": "off",
        "noSvgWithoutTitle": "off",
        "noNoninteractiveElementInteractions": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "includes": [
      "apps/**",
      "packages/**",
      "!node_modules/**",
      "!*.config.*",
      "!*.json",
      "!**/tsconfig*.json",
      "!**/*.svg",
      "!.turbo/**",
      "!.next/**",
      "!apps/web/public/open-todo-zero/vendor/**"
    ]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all"
    }
  },
  "files": {
    "includes": [
      "apps/**",
      "packages/**",
      "!node_modules",
      "!*.config.*",
      "!*.json",
      "!**/tsconfig*.json",
      "!**/*.svg",
      "!.turbo",
      "!.next",
      "!sw.js",
      "!.vscode",
      "!.claude",
      "!apps/web/public/open-todo-zero/vendor"
    ]
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off",
        "useSortedAttributes": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/__tests__/**", "**/*.test.*", "**/*.spec.*"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/__tests__/**",
        "**/*.test.*",
        "**/*.spec.*",
        "packages/**",
        "**/*.tsx",
        "**/scripts/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/public/open-todo-zero/**/*.js",
        "apps/web/public/open-todo-zero/**/*.mjs"
      ],
      "javascript": {
        "globals": [
          "StillDeadlines",
          "InboxTodoHost",
          "toastui",
          "DOMPurify",
          "StillCloud",
          "StillAlerts",
          "StillOpenRouter"
        ]
      },
      "linter": {
        "rules": {
          "style": {
            "noParameterAssign": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/public/open-todo-zero/**/*.css"],
      "linter": {
        "rules": {
          "style": {
            "noDescendingSpecificity": "off"
          }
        }
      }
    }
  ],
  "extends": ["ultracite/biome/core", "ultracite/biome/next"]
}
